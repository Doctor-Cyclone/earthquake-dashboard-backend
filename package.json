{
  "name": "earthquake-dashboard-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend for an earthquake dashboard powered by USGS data",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "format": "prettier --write src test",
    "format:check": "prettier --check src test"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3"
  }
}
